@using Academy.Models;
@using Microsoft.EntityFrameworkCore;
@inject IDbContextFactory<AcademyContext> DBFactory;

<h3>CBGroup</h3>

<div class="mb-3">
    <span class="text-danger">*</span>
    <label for="group" class="form-label">group:</label>
    @* <InputNumber id="group" @bind-Value="Lesson.group" class="form-control" aria-required="true" />
    <ValidationMessage For="() => Lesson.group" class="text-danger"/> *@
	<select @bind="group" @bind:after="SetGroup" class="form-control">
        <option value="-1">--- Выберте группу ---</option>
        @foreach(Group group in Context.Groups)
        {
            <option value="@group.group_id">"@group.group_name"</option>
        }
    </select>
</div>
@code 
{
    [Parameter]
    public Group Group { get; set; }

    [Parameter]
    public EventCallback<Group> GroupChanged { get; set; }

    [Parameter]
    public AcademyContext Context { get; set; }

    int group = -1;

    void SetGroup()
    {
        Group = Context.Groups.Where(g => g.group_id == this.group).First();
        GroupChanged.InvokeAsync(Group);
    }
}
