@using Academy.Models;
@using Microsoft.EntityFrameworkCore;
@inject IDbContextFactory<AcademyContext> DbFactory;


<h3>AddRequiredDiscipline</h3>


<form>
    <InputSelect @bind-Value="discipline">
        <option disabled value="-1">---Выберите дисциплину---</option>
        @foreach(Discipline d in disciplines) 
        {
            if 
            (
                Discipline.RequiredDisciplines.Contains(
                    new DependentDisciplines
                    {
                        discipline = d.discipline_id,
                        dependent_discipline = Discipline.discipline_id
                    }
                )
            ) continue;
            <option value="@d.discipline_id">@d.discipline_name</option>
        }
    </InputSelect>
    <button type="button" @onclick="AddDiscipline">Добавить</button>
    <li>
        @foreach(DependentDisciplines rd in requiredDisciplines)
        {
            <li>@rd.Discipline.discipline_name</li>
        }
    </li>
    <hr />
    <li>
        @foreach(DependentDisciplines rd in Discipline.RequiredDisciplines)
        {
            <li>@rd.Discipline.discipline_name</li>
        }
    </li>

</form>
@code 
{
    [Parameter]
    public Discipline Discipline { get; set; }

    // [Parameter]
    // public List<RequiredDisciplines> requiredDisciplines { get; set; }

    List<Discipline> disciplines = default!;
    List<DependentDisciplines> requiredDisciplines = new List<DependentDisciplines>();

    int discipline = -1;

    protected override void OnInitialized()
    {
        disciplines = DbFactory.CreateDbContext()
                                        .Disciplines.Where(d => d.discipline_id != Discipline.discipline_id)
                                        .ToList();
    }
    void AddDiscipline()
    {
        if (discipline == -1) return;
        DependentDisciplines rd = new DependentDisciplines
        {
            discipline = this.discipline,
            dependent_discipline = Discipline.discipline_id,
            Discipline = DbFactory.CreateDbContext().Disciplines.Where(d => d.discipline_id == this.discipline).First(),
            DependentDispline = Discipline
        };
        this.requiredDisciplines.Add(rd);
        this.discipline = -1;
    }
}
