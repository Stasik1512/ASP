@page "/disciplines/details"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

@* <h1>Details</h1>
 *@
<div>
    @* <h2>Discipline</h2>
    <hr /> *@
    @if (discipline is null)
    {
        <p><em>Loading...</em></p>
    }
    else 
    {
        <div class="controls">
            <h1>@discipline.discipline_name</h1>
            <a href="@($"/disciplines/edit?discipline_id={discipline.discipline_id}")" class="btn btn-primary">Edit</a>
        </div>
        <hr />

        <dl class="row">
            <dt class="col-sm-2">discipline_id</dt>           <dd class="col-sm-10">@discipline.discipline_id</dd>
            <dt class="col-sm-2">discipline_name</dt>           <dd class="col-sm-10">@discipline.discipline_name</dd>
            <dt class="col-sm-2">number_of_lessons</dt>         <dd class="col-sm-10">@discipline.number_of_lessons</dd>
        </dl>
        <div>
            @* <a href="@($"/disciplines")">Back to List</a> *@
        </div>
        <h3>Преподаватели @(discipline.TDR.Count)</h3>
        <ul>
            @foreach(TeachersDisciplinesRelation tdr in discipline.TDR)
            {
                <h5><li>@tdr.Teacher.full_name</li></h5>
            }
        </ul>
        <div class="adjacent-disciplines">
            @* <div>
                <h5>Требуемые дисциплины</h5>
                @if(discipline.RequiredDisciplines != null)
                {
                    <ul>
                        @foreach(RequiredDisciplines rd in discipline.RequiredDisciplines)
                        {
                            <li>@rd.RequiredDiscipline.discipline_name</li>
                        }
                    </ul>
                }
            </div> *@
            <div>
                <h5>Требуемые дисципллины</h5>
                @if(discipline.DependentDisciplines != null)
                {
                    <ul>
                        @foreach(DependentDisciplines rd in discipline.RequiredDisciplines)
                        {
                            <li>
                                <a href=@($"/Disciplines/details?discipline_id={rd.discipline}")>
                                    @rd.Discipline.discipline_name
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div>
                <h5>Зависимые дисципллины</h5>
                @if(discipline.DependentDisciplines != null)
                {
                    <ul>
                        @foreach(DependentDisciplines dd in discipline.DependentDisciplines)
                        {
                            <li>
                                <a href=@($"/Disciplines/details?discipline_id={dd.dependent_discipline}")>
                                    @dd.DependentDispline.discipline_name
                                </a>

                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
        <hr />

    }
</div>

@code 
{
    private Discipline? discipline;

    [SupplyParameterFromQuery]
    private int discipline_id { get; set; }

    //List<Discipline> requiredDisciplines = default;
    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        discipline = await context.Disciplines
                                                .Include(d => d.TDR)
                                                    .ThenInclude( tdr => tdr.Teacher)
                                                .Include(d => d.DependentDisciplines)
                                                    .ThenInclude(dd => dd.DependentDispline)
                                                .Include(d => d.RequiredDisciplines)
                                                    .ThenInclude(rd => rd.Discipline)
                                                .FirstOrDefaultAsync(m => m.discipline_id == discipline_id);
                                                
                                                

        if (discipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
