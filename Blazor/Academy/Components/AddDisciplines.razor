@using Academy.Models;
@using Microsoft.EntityFrameworkCore;
@inject IDbContextFactory<AcademyContext> DbFactory;


@* <h3>AddDisciplines</h3> *@
<form @onsubmit="Update">
    <h5>Выберите дисциплину</h5>
    <InputSelect @bind-Value="discipline" class="form-control">
        <option value="-1" disabled>---Выберите дисципилину---</option>
        @if(Disciplines != null)
        {
            @foreach (Discipline discipline in Disciplines)
            {
                @if
                (
                    TDR.Any(tdr => tdr.discipline == discipline.discipline_id) ||
                    NewDisciplines.Any(nd => nd.discipline == discipline.discipline_id)
                )continue;
                <option value="@discipline.discipline_id">@discipline.discipline_name</option>
            }
        }
    </InputSelect>
    <button class="btn btn-primary" @onclick="AddDiscipline">Добавить</button>
    <ul>
        @foreach (TeachersDisciplinesRelation tdr in NewDisciplines)
        {
            <li>@tdr.Discipline.discipline_name</li>
        }
    </ul>
    <hr />
    @if(TDR != null)
    {
        <ul>
            @foreach (TeachersDisciplinesRelation tdr in TDR)
            {
                <li>@tdr.Discipline.discipline_name</li>
            }
        </ul>
    } 
</form>
@code
{
    [Parameter]
    public Teacher Teacher { get; set; }

    ICollection<Discipline> Disciplines { get; set; }
    ICollection<TeachersDisciplinesRelation> TDR { get; set; }
    List<TeachersDisciplinesRelation> NewDisciplines = new List<TeachersDisciplinesRelation>();

    int discipline = -1;

    protected override async Task OnInitializedAsync()
    {
        using AcademyContext context = DbFactory.CreateDbContext();
        Disciplines = await context.Disciplines.ToListAsync();
        TDR = await context.TeachersDisciplinesRelation.Where(t => t.teacher == Teacher.teacher_id).ToListAsync();
    }
    // protected override void OnInitialized()
    // {
    //     using AcademyContext context = DbFactory.CreateDbContext();
    //     Disciplines = context.Disciplines.ToList();
    //     TDR = context.TeachersDisciplinesRelation.Where(t => t.teacher == Teacher.teacher_id).ToList();
    // }
    void AddDiscipline()
    {
        if (discipline == -1) return;
        TeachersDisciplinesRelation newRelation = new TeachersDisciplinesRelation
            {
                teacher = Teacher.teacher_id,
                discipline = this.discipline
            };
        //newRelation.Teacher = this.Teacher;
        newRelation.Discipline = Disciplines.Where(d => d.discipline_id == this.discipline).FirstOrDefault();
        NewDisciplines.Add
        (
            newRelation
        );
        this.discipline = -1;
    }
    public async Task Update()
    {
        
    }
    

}
